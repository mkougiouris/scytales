{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "MassTransit": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "RabbitMq": ""
  },
  "WorkflowRules": {
    "MinimumAge": 18,
    "ManualReviewBelowAge": 21,
    "AutoApprovedCategories": [ "B" ],
    "TimeZoneId": "Europe/Athens",
    "Photo": {
      "AllowedFormats": [ "Jpeg", "Png" ],
      "MinFileSizeBytes": 10240,
      "MinQualityScore": 30,
      "ManualReviewQualityThreshold": 60
    }
  },
  "Watchlist": {
    "NationalIds": [ "XX000000" ]
  },
  "Messaging": {
    "RetryLimit": 5,
    "RetryMinInterval": "00:00:01",
    "RetryMaxInterval": "00:00:30",
    "RetryIntervalDelta": "00:00:02"
  }
}
